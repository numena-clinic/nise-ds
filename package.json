{
  "name": "nise-ds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nise Design System — the code-first design system for Numena. Consumes the Numena brand (numena-clinic/numena-brand) and owns interface tokens, components, and the build.",
  "scripts": {
    "tokens:build": "node tokens/build.mjs",
    "tokens:validate": "node tokens/validate.mjs",
    "check:usage": "node scripts/check-token-usage.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite --config vite.config.explorer.ts",
    "build:explorer": "vite build --config vite.config.explorer.ts",
    "preview:explorer": "vite preview --config vite.config.explorer.ts",
    "theme:apply": "node scripts/apply-theme.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "export:openpencil": "node scripts/export-openpencil.mjs",
    "build": "npm run tokens:build && npm run typecheck && npm run build-storybook",
    "verify": "npm run tokens:validate && npm run check:usage && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "storybook": "^10.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
