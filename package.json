{
  "name": "nise-ds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nise Design System — the code-first design system for Numena. Consumes the Numena brand (numena-clinic/numena-brand) and owns interface tokens, components, and the build.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/nise-ds.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/tokens/tokens.css",
    "src/styles"
  ],
  "scripts": {
    "tokens:build": "node tokens/build.mjs",
    "tokens:validate": "node tokens/validate.mjs",
    "check:usage": "node scripts/check-token-usage.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "dev": "vite --config vite.config.explorer.ts",
    "build:lib": "vite build --config vite.config.lib.ts && tsc -p tsconfig.build.json",
    "build:explorer": "vite build --config vite.config.explorer.ts",
    "preview:explorer": "vite preview --config vite.config.explorer.ts",
    "theme:apply": "node scripts/apply-theme.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "export:openpencil": "node scripts/export-openpencil.mjs",
    "build": "npm run tokens:build && npm run build-storybook",
    "verify": "npm run tokens:validate && npm run check:usage && npm run lint && npm run typecheck && npm run test",
    "preview:storybook": "vite preview --outDir storybook-static --host 127.0.0.1 --port 6006 --strictPort",
    "chromatic": "chromatic --storybook-build-dir storybook-static"
  },
  "dependencies": {
    "@fontsource/albert-sans": "^5.3.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-mcp": "^10.6.5",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "chromatic": "^18.13.4",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "storybook": "^10.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
