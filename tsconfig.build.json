{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "allowImportingTsExtensions": false
  },
  "include": [
    "src/index.ts",
    "src/components/**/*",
    "src/icons/**/*",
    "src/lib/**/*"
  ],
  "exclude": [
    "src/**/*.stories.tsx"
  ]
}
